void LoadDataFromFileToVector(string& FileName, vector <string>& vscustomers, fstream& thebank) {

	thebank.open(FileName, ios::in);

	if (thebank.is_open()) {
		string Line;

		while (getline(thebank, Line)) {
			if (Line != "")
				vscustomers.push_back(Line);

		}

	}
	thebank.close();
	//return vscustomers;
}

string full(string& s1, string delim) {
	int pos = 0;
	string sWord = "";

	pos = s1.find(delim);
	sWord = s1.substr(0, pos);

	s1.erase(0, pos + delim.length());
	return sWord;
}

vector <stcustomers> PrintEachWordInString(string& delim, vector <stcustomers>& vcustomers, stcustomers& customers, vector <string>& vscustomers) {



	for (string scustomers : vscustomers) {


		customers.accontnumber = full(scustomers, delim);


		customers.pincode = full(scustomers, delim);

		customers.name = full(scustomers, delim);

		customers.phone = full(scustomers, delim);

		customers.balance = stoi(full(scustomers, delim));


		vcustomers.push_back(customers);

	}

	return vcustomers;
}

void sendcodetofile(vector <stcustomers>& vcustomers, stcustomers& customer, fstream& newfile, string& txt) {

			///vcustomers.push_back(customers);
	string s;
	newfile.open(txt, ios::out);
	for (stcustomers customers : vcustomers) {
			if (customers.accontnumber != "") {
			
			s = customers.accontnumber + "#//#" + customers.pincode + "#//#" + customers.name + "#//#" + customers.phone + "#//#" + to_string(customers.balance) + "\n";

			if (newfile.is_open())
				newfile << s;
			}
	}
	newfile.close();
}

bool checkaccontnumber(vector <stcustomers>& vcustomers,stcustomers& customer,string& accont) {
	for (stcustomers& scustomer : vcustomers) {
		if (scustomer.accontnumber == accont) {
			customer = scustomer;
			return 1;
		}
	}
	return 0;
}

bool checkpincode(vector <stcustomers>& vcustomers, string& pincode) {
	for (stcustomers& customer : vcustomers) {
		if (customer.pincode == pincode)
			return 1;
	}
	return 0;
}

bool checkthepassword(vector <stcustomers>& vcustomers, stcustomers &customer,string &accont, string &pincode) {

	return (checkaccontnumber(vcustomers,customer,accont) && checkpincode(vcustomers, pincode))? 1:0;
	
}

