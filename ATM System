void addnewdata(vector <stcustomers>& vcustomers, stcustomers& customer) {
	for (stcustomers& scustomer : vcustomers) {
		if (scustomer.accontnumber == customer.accontnumber) {
			scustomer.accontnumber = "";
			break;
		}
	}
	vcustomers.push_back(customer);
}

void ATMchoose(vector <stcustomers>& vcustomers, stcustomers& customer, fstream &bank, string txt) {
	short choose = 0;
	do {
	choose = ATMscreen();

	if (choose == echoose::equick) 
		quick(customer);
	if (choose == echoose::enormal)
		normal(customer);
	if (choose == echoose::edeposit)
		deposit(customer);
	if (choose == echoose::echeck)
		check(customer);
	if (choose == echoose::elogout)
		break;
	
	} while (choose <= 4);
	addnewdata(vcustomers, customer);
	sendcodetofile(vcustomers,customer, bank, txt);
}

void ATM() {
